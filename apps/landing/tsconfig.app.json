{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true
  },
  "include": ["src/hero/**/*.ts", "../docs/src/components/angular/examples/landing-page-diagram/**/*.ts"],
  "exclude": ["../docs/src/components/angular/examples/landing-page-diagram/diagram/diagram.component.ts"],
  "angularCompilerOptions": {
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
