{
  "name": "landing",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check-types": "astro check && tsc --noEmit -p tsconfig.app.json",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier . --check",
    "format:fix": "prettier . --write",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "parity": "playwright test --config playwright.parity.config.ts",
    "perf": "node scripts/perf.mjs",
    "sketch:capture": "node scripts/capture-hero-sketch.mjs",
    "still:capture": "node scripts/capture-hero-still.mjs"
  },
  "dependencies": {
    "@angular/common": "19.2.25",
    "@angular/core": "19.2.25",
    "@angular/platform-browser": "19.2.25",
    "astro": "7.4.5",
    "ng-diagram": "workspace:*",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "uplot": "^1.6.32",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.9.6",
    "@angular/build": "19.2.27",
    "@angular/compiler": "19.2.25",
    "@angular/compiler-cli": "19.2.25",
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.5",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "26.6.4",
    "@typescript-eslint/parser": "^8.71.1",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^2.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "1.85.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.71.1"
  }
}
