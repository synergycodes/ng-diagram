---
import { LINKS } from '../config/landing';
import PageLink from './PageLink.astro';
---

<section class="agent block" id="agent" aria-labelledby="agent-title">
  <div class="wrap">
    <h2 id="agent-title" class="grad">Your AI agent already speaks ngDiagram</h2>
    <p class="lead">
      Agent skills, an official MCP server, and Markdown docs – so your agent works from the real API instead of
      guessing at one.
    </p>
    <p class="cta-row">
      <PageLink class="text-link" href={LINKS.ai}>Read the Build with AI guide</PageLink>
    </p>
  </div>
</section>
